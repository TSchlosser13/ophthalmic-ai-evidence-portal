---
import { ArrowRight, House, Search } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/base';
---

<BaseLayout title="Page not found" description="The requested evidence-portal page could not be found.">
  <section class="not-found container">
    <div class="error-visual" aria-hidden="true"><span>4</span><div class="retina"><i></i></div><span>4</span></div>
    <div class="error-copy">
      <p class="eyebrow">The route ends here</p>
      <h1>Page not found</h1>
      <p>The requested page is not available in this evidence portal. Return to the overview, search the public index, or continue into the publication explorer.</p>
      <div class="error-actions">
        <a class="button primary" href={withBase('/')}><House size={17} /> Return to the portal</a>
        <a class="button" href={withBase('/search/')}><Search size={17} /> Search</a>
        <a class="text-link" href={withBase('/publications/')}>Explore publications <ArrowRight size={16} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1fr); gap: clamp(2rem, 8vw, 7rem); align-items: center; min-height: 72vh; padding-block: 4rem; }
  .error-visual { display: flex; justify-content: center; align-items: center; color: var(--faint); font-family: var(--font-serif); font-size: clamp(5rem, 13vw, 10rem); font-weight: 700; line-height: 1; }
  .retina { position: relative; width: clamp(5rem, 12vw, 9rem); aspect-ratio: 1; border: 1px solid color-mix(in srgb, var(--teal) 55%, var(--line)); border-radius: 50%; background: radial-gradient(circle, var(--teal) 0 7%, transparent 8% 18%, color-mix(in srgb, var(--blue) 18%, transparent) 19% 20%, transparent 21% 36%, color-mix(in srgb, var(--teal) 18%, transparent) 37% 38%, transparent 39%); box-shadow: 0 0 0 1.2rem color-mix(in srgb, var(--teal) 4%, transparent), 0 0 0 2.4rem color-mix(in srgb, var(--blue) 3%, transparent); }
  .retina::before, .retina::after { content: ''; position: absolute; inset: 50% 8% auto; height: 1px; background: color-mix(in srgb, var(--teal) 25%, transparent); transform: rotate(28deg); }
  .retina::after { transform: rotate(-28deg); }
  .retina i { position: absolute; inset: 22%; border: 1px solid color-mix(in srgb, var(--blue) 35%, transparent); border-radius: 50%; }
  .error-copy { max-width: 620px; }
  .error-copy h1 { margin-bottom: 0.8rem; font-size: clamp(2.5rem, 6vw, 4.8rem); text-wrap: balance; }
  .error-copy > p:not(.eyebrow) { color: var(--muted); font-size: 1.02rem; }
  .error-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; margin-top: 1.5rem; }
  .text-link { display: inline-flex; gap: 0.35rem; align-items: center; margin-left: 0.4rem; font-size: 0.82rem; font-weight: 720; text-decoration: none; }
  @media (max-width: 760px) { .not-found { grid-template-columns: 1fr; gap: 2rem; } .error-visual { justify-content: flex-start; } .error-actions .button { flex: 1 1 auto; } .text-link { width: 100%; margin: 0.5rem 0 0; } }
</style>
