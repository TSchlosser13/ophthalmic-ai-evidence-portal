---
import { Braces, Scale, ShieldCheck } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EvidenceAssignmentTable from '@/components/EvidenceAssignmentTable.astro';
import SectionNav from '@/components/SectionNav.astro';
import articles from '@/data/generated/articles.json';
import metadata from '@/data/generated/review-metadata.json';
import supplement from '@/data/generated/supplement.json';

const generalRows = articles.flatMap((article) => article.generalEvidenceAssignments.map((assignment) => ({
  citationKey: article.citationKey, slug: article.slug, title: article.title, year: article.year, dimension: assignment.dimension, stance: assignment.stance
})));
const ethicsRows = articles.flatMap((article) => article.ethicsEvidenceAssignments.map((assignment) => ({
  citationKey: article.citationKey, slug: article.slug, title: article.title, year: article.year, dimension: assignment.dimension, stance: assignment.stance
})));
const { general: generalRules, ethics: ethicsRules } = supplement.evidenceMapRules;
const navItems = [
  { slug: 'criteria', heading: 'Operational definitions' },
  { slug: 'general-assignments', heading: 'General assignments' },
  { slug: 'ethics-assignments', heading: 'Ethics assignments' }
];
---

<BaseLayout title="Evidence-gap assignment tables" description="Searchable publication-level general and ethics assignments underlying the ophthalmic AI evidence maps.">
  <PageHeader
    eyebrow="From aggregate pattern to publication"
    title="Evidence-gap assignments"
    intro="Inspect every publication-level assignment in the general and ethics evidence-gap maps. Combine dimension, framing, and publication filters, then follow any row into its publication page."
  />
  <div class="container assignment-overview">
    <div><Scale size={20} aria-hidden="true" /><span>General map</span><strong>{generalRows.length.toLocaleString('en-GB')}</strong><p>assignments across nine dimensions</p></div>
    <div><ShieldCheck size={20} aria-hidden="true" /><span>Ethics map</span><strong>{ethicsRows.length.toLocaleString('en-GB')}</strong><p>assignments across nine dimensions</p></div>
    <div><Braces size={20} aria-hidden="true" /><span>Classification unit</span><strong>Publication</strong><p>with multiple assignments permitted</p></div>
  </div>
  <div class="container assignment-layout">
    <aside><SectionNav title="Evidence-map sections" items={navItems} /></aside>
    <main class="assignment-content">
      <div class="interpretation-callout"><span aria-hidden="true">!</span><div><strong>Interpretation boundary</strong><p>{metadata.evidenceMapCaution}</p></div></div>
      <section class="criteria" id="criteria" aria-labelledby="criteria-title">
        <div class="criteria-intro">
          <p class="eyebrow">Operational definitions</p>
          <h2 id="criteria-title">What each evidence-map category filters</h2>
          <p>Selecting a dimension retains publications that meet its <strong>evidence required</strong> criterion. Content described as <strong>not sufficient</strong> does not create an assignment. Expand any dimension below to see its decision boundary.</p>
        </div>
        <div class="criteria-group general-criteria">
          <header><span>01</span><div><h3>General-map dimensions</h3><p><strong>Positive</strong> means that the publication frames AI as enabling or improving the named dimension. <strong>Negative</strong> means that it frames AI as creating or exposing a barrier, risk, failure, or constraint. <strong>Balanced</strong> requires explicit qualifying evidence in both directions within that dimension.</p></div></header>
          <div class="criteria-list">
            {generalRules.map((rule) => (
              <details>
                <summary>{rule.dimension}<span aria-hidden="true">+</span></summary>
                <dl>
                  <div><dt>Evidence required</dt><dd>{rule.required}</dd></div>
                  <div><dt>Not sufficient</dt><dd>{rule.notSufficient}</dd></div>
                </dl>
              </details>
            ))}
          </div>
        </div>
        <div class="criteria-group ethics-criteria">
          <header><span>02</span><div><h3>Ethics-map dimensions</h3><p><strong>Caused</strong> means that the publication frames AI as introducing or amplifying the issue. <strong>Resolved</strong> requires a reported AI-related mechanism that mitigates the issue. <strong>Caused and resolved</strong> requires explicit evidence in both directions.</p></div></header>
          <div class="criteria-list">
            {ethicsRules.map((rule) => (
              <details>
                <summary>{rule.dimension}<span aria-hidden="true">+</span></summary>
                <dl>
                  <div><dt>Evidence required</dt><dd>{rule.required}</dd></div>
                  <div><dt>Not sufficient</dt><dd>{rule.notSufficient}</dd></div>
                </dl>
              </details>
            ))}
          </div>
        </div>
      </section>
      <EvidenceAssignmentTable
        id="general-assignments"
        title="General dimensions"
        description={`${generalRows.length.toLocaleString('en-GB')} assignments across nine dimensions, categorised as positive, negative, or balanced according to each publication's framing.`}
        rows={generalRows}
        downloadBase="general-evidence-assignments"
      />
      <EvidenceAssignmentTable
        id="ethics-assignments"
        title="Ethics and governance dimensions"
        description={`${ethicsRows.length.toLocaleString('en-GB')} assignments across nine dimensions, distinguishing issues framed as caused by AI, mitigated by an AI-related approach, or caused and resolved.`}
        rows={ethicsRows}
        downloadBase="ethics-evidence-assignments"
      />
    </main>
  </div>
</BaseLayout>

<style>
  .assignment-overview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; margin-top: 2.5rem; background: var(--surface); box-shadow: 0 14px 40px color-mix(in srgb, var(--ink) 6%, transparent); }
  .assignment-overview > div { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.15rem 0.7rem; border-right: 1px solid var(--line); padding: 1.1rem; }
  .assignment-overview > div:last-child { border-right: 0; }
  .assignment-overview svg { grid-row: span 3; color: var(--teal); }
  .assignment-overview span { color: var(--faint); font-size: 0.65rem; font-weight: 760; letter-spacing: 0.07em; text-transform: uppercase; }
  .assignment-overview strong { font-family: var(--font-serif); font-size: 1.35rem; }
  .assignment-overview p { margin: 0; color: var(--muted); font-size: 0.72rem; }
  .assignment-layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 4rem); padding-block: clamp(3rem, 6vw, 5rem) 6rem; }
  .assignment-content { min-width: 0; }
  .interpretation-callout { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.8rem; align-items: start; border: 1px solid color-mix(in srgb, var(--amber) 35%, var(--line)); border-radius: 0.8rem; margin-bottom: 3rem; background: color-mix(in srgb, var(--amber) 7%, var(--surface)); padding: 1rem; }
  .interpretation-callout > span { display: grid; width: 1.7rem; height: 1.7rem; place-items: center; border: 1px solid var(--amber); border-radius: 50%; color: var(--amber); font-weight: 800; }
  .interpretation-callout strong { display: block; margin-bottom: 0.2rem; }
  .interpretation-callout p { margin: 0; color: var(--muted); font-size: 0.84rem; }
  .criteria { scroll-margin-top: calc(var(--header-height) + 5rem); }
  .criteria-intro { max-width: 850px; margin-bottom: 2.5rem; }
  .criteria-intro h2 { margin: 0.2rem 0 0.8rem; font-size: clamp(1.8rem, 3vw, 2.35rem); }
  .criteria-intro p:last-child { color: var(--muted); }
  .criteria-group + .criteria-group { margin-top: 3.25rem; }
  .criteria-group > header { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr); gap: 0.75rem; align-items: start; margin-bottom: 1.1rem; }
  .criteria-group > header > span { display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid var(--teal); border-radius: 50%; color: var(--teal); font-size: 0.62rem; font-weight: 760; }
  .ethics-criteria > header > span { border-color: var(--amber); color: var(--amber); }
  .criteria-group h3 { margin: 0 0 0.35rem; font-family: var(--font-serif); font-size: 1.4rem; }
  .criteria-group header p { margin: 0; color: var(--muted); font-size: 0.82rem; }
  .criteria-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .criteria-list details { overflow: hidden; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--surface); box-shadow: 0 6px 20px color-mix(in srgb, var(--ink) 3%, transparent); }
  .criteria-list summary { display: flex; justify-content: space-between; gap: 0.6rem; align-items: center; padding: 0.9rem 1rem; font-weight: 700; list-style: none; }
  .criteria-list summary::-webkit-details-marker { display: none; }
  .criteria-list summary span { display: grid; width: 1.4rem; height: 1.4rem; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--teal); transition: transform 150ms ease; }
  .criteria-list details[open] summary { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--teal) 5%, var(--surface)); }
  .criteria-list details[open] summary span { transform: rotate(45deg); }
  .criteria-list dl { margin: 0; padding: 0.25rem 1rem 1rem; }
  .criteria-list dl div { margin-top: 0.85rem; }
  .criteria-list dt { color: var(--muted); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
  .criteria-list dd { margin: 0.25rem 0 0; font-size: 0.84rem; line-height: 1.6; }
  @media (max-width: 980px) { .assignment-layout { grid-template-columns: 1fr; } .assignment-layout > aside { position: relative; z-index: 9; } }
  @media (max-width: 760px) { .assignment-overview { grid-template-columns: 1fr; } .assignment-overview > div { border-right: 0; border-bottom: 1px solid var(--line); } .assignment-overview > div:last-child { border-bottom: 0; } .criteria { scroll-margin-top: calc(var(--header-height) + 8rem); } .criteria-list { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .criteria-list summary span { transition: none; } }
</style>
