---
import { withBase } from '@/lib/base';
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-grid">
    <div>
      <div class="footer-title"><span class="footer-pulse" aria-hidden="true"></span><strong>Ophthalmic AI Evidence Portal</strong></div>
      <p>An interactive scientific synthesis of ophthalmic-imaging AI evidence and its clinical translation.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href={withBase('/methods/')}>Methods and transparency</a>
      <a href={withBase('/downloads/')}>Data and downloads</a>
      <a href={withBase('/supplementary/')}>Supplementary material</a>
    </nav>
    <div class="footer-meta">
      <span><i aria-hidden="true"></i> Static, accessible, privacy-preserving</span>
      <span>No cookies or analytics</span>
      <span>© 2026 Review authors</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid color-mix(in srgb, var(--cyan) 20%, var(--line));
    background:
      radial-gradient(circle at 8% 120%, color-mix(in srgb, var(--cyan) 12%, transparent), transparent 24rem),
      linear-gradient(145deg, var(--surface-2), color-mix(in srgb, var(--surface) 86%, var(--surface-2)));
    padding: 3.4rem 0;
  }
  .site-footer::after {
    position: absolute;
    right: 6%;
    bottom: -96px;
    width: 210px;
    height: 210px;
    border: 1px solid color-mix(in srgb, var(--cyan) 16%, transparent);
    border-radius: 50%;
    box-shadow: inset 0 0 0 34px color-mix(in srgb, var(--cyan) 2%, transparent), inset 0 0 0 35px color-mix(in srgb, var(--cyan) 10%, transparent);
    content: "";
    pointer-events: none;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 0.8fr;
    gap: 2.5rem;
  }
  strong {
    display: inline;
  }
  .footer-title {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .footer-pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--cyan) 13%, transparent), 0 0 18px var(--cyan);
  }
  p {
    max-width: 520px;
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
  }
  nav,
  .footer-meta {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  nav a,
  .footer-meta {
    color: var(--muted);
    font-size: 0.82rem;
  }
  nav a {
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
  }
  .footer-meta span:first-child {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink);
  }
  .footer-meta i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
