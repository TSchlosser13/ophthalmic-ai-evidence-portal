---
import { britishText } from '@/lib/britishEnglish';
import { Download, RotateCcw, Search, SlidersHorizontal } from '@lucide/astro';
import { withBase } from '@/lib/base';

interface Row {
  citationKey: string;
  slug: string;
  title: string;
  year: number;
  dimension: string;
  stance: string;
}
interface Props {
  id: string;
  title: string;
  description: string;
  rows: Row[];
  downloadBase: string;
}
const { id, title, description, rows, downloadBase } = Astro.props;
const dimensions = [...new Set(rows.map((row) => row.dimension))];
const stances = [...new Set(rows.map((row) => row.stance))];
---

<section class="assignment-section" id={id} data-assignment-table data-table-id={id}>
  <header class="section-heading">
    <div>
      <p class="table-kicker"><span aria-hidden="true"></span> Publication-level matrix</p>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="cluster"><a class="button" href={withBase(`/downloads/${downloadBase}.csv`)} download><Download size={16} /> CSV</a><a class="button" href={withBase(`/downloads/${downloadBase}.json`)} download>JSON</a></div>
  </header>

  <div class="assignment-controls" data-pagefind-ignore>
    <div class="controls-heading"><SlidersHorizontal size={18} aria-hidden="true" /><div><strong>Refine assignments</strong><span>Combine filters to focus the table.</span></div></div>
    <label class="search-control"><span class="field-label">Search publications</span><span><Search size={18} /><input class="input" type="search" placeholder="Title or citation key" data-assignment-search /></span></label>
    <label><span class="field-label">Dimension</span><select class="select" data-assignment-dimension><option value="">All dimensions</option>{dimensions.map((value) => <option value={value}>{britishText(value)}</option>)}</select></label>
    <label><span class="field-label">Framing</span><select class="select" data-assignment-stance><option value="">All categories</option>{stances.map((value) => <option value={value}>{value}</option>)}</select></label>
    <label><span class="field-label">Sort by</span><select class="select" data-assignment-sort><option value="dimension">Dimension</option><option value="year">Newest publication</option><option value="title">Publication title</option></select></label>
    <button class="button clear-button" type="button" data-assignment-clear disabled><RotateCcw size={16} /> Clear</button>
  </div>

  <div class="assignment-summary" aria-live="polite">
    <p>Showing <strong data-assignment-count>{rows.length.toLocaleString('en-GB')}</strong> of <strong>{rows.length.toLocaleString('en-GB')}</strong> assignments</p>
    <span>Filters are reflected in this page’s URL.</span>
  </div>
  <div class="table-wrap assignment-wrap" data-assignment-wrap tabindex="0" aria-label={`${title} assignment table, horizontally scrollable on smaller screens`}>
    <table>
      <caption class="visually-hidden">{title}</caption>
      <thead><tr><th scope="col">Dimension</th><th scope="col">Framing</th><th scope="col">Year</th><th scope="col">Publication</th><th scope="col">Citation key</th></tr></thead>
      <tbody>
        {rows.map((row) => <tr data-assignment-row data-search={`${row.title} ${row.citationKey}`.toLowerCase()} data-dimension={row.dimension} data-stance={row.stance} data-year={row.year} data-title={row.title}>
          <td data-label="Dimension">{britishText(row.dimension)}</td>
          <td data-label="Framing"><span class:list={['badge', { green: ['positive', 'resolved'].includes(row.stance), red: ['negative', 'caused'].includes(row.stance), amber: ['balanced', 'both'].includes(row.stance) }]}>{row.stance}</span></td>
          <td data-label="Year">{row.year}</td>
          <td data-label="Publication"><a href={withBase(`/publications/${row.slug}/`)}>{row.title}</a></td>
          <td data-label="Citation key"><code>{row.citationKey}</code></td>
        </tr>)}
      </tbody>
    </table>
  </div>
  <div class="empty-state" hidden data-assignment-empty><div><strong>No matching assignments</strong><p>Try a broader publication term or clear one of the category filters.</p><button class="button" type="button" data-assignment-empty-clear>Clear filters</button></div></div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-assignment-table]').forEach((root) => {
    const search = root.querySelector<HTMLInputElement>('[data-assignment-search]')!;
    const dimension = root.querySelector<HTMLSelectElement>('[data-assignment-dimension]')!;
    const stance = root.querySelector<HTMLSelectElement>('[data-assignment-stance]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-assignment-sort]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-assignment-clear]')!;
    const emptyClear = root.querySelector<HTMLButtonElement>('[data-assignment-empty-clear]')!;
    const count = root.querySelector<HTMLElement>('[data-assignment-count]')!;
    const wrap = root.querySelector<HTMLElement>('[data-assignment-wrap]')!;
    const empty = root.querySelector<HTMLElement>('[data-assignment-empty]')!;
    const body = root.querySelector<HTMLTableSectionElement>('tbody')!;
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('[data-assignment-row]')];
    const prefix = root.dataset.tableId ?? 'assignments';

    const params = new URLSearchParams(window.location.search);
    search.value = params.get(`${prefix}-q`) ?? '';
    dimension.value = params.get(`${prefix}-dimension`) ?? '';
    stance.value = params.get(`${prefix}-stance`) ?? '';
    sort.value = params.get(`${prefix}-sort`) ?? 'dimension';

    const syncUrl = () => {
      const next = new URLSearchParams(window.location.search);
      const values: Array<[string, string, string]> = [
        [`${prefix}-q`, search.value.trim(), ''],
        [`${prefix}-dimension`, dimension.value, ''],
        [`${prefix}-stance`, stance.value, ''],
        [`${prefix}-sort`, sort.value, 'dimension']
      ];
      values.forEach(([key, value, fallback]) => value && value !== fallback ? next.set(key, value) : next.delete(key));
      history.replaceState(null, '', `${window.location.pathname}${next.toString() ? `?${next}` : ''}${window.location.hash}`);
    };

    const update = () => {
      const terms = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const ordered = [...rows].sort((a, b) => {
        if (sort.value === 'year') return Number(b.dataset.year) - Number(a.dataset.year) || (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
        if (sort.value === 'title') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
        return (a.dataset.dimension ?? '').localeCompare(b.dataset.dimension ?? '') || (a.dataset.stance ?? '').localeCompare(b.dataset.stance ?? '');
      });
      let visible = 0;
      for (const row of ordered) {
        const haystack = row.dataset.search ?? '';
        const show = terms.every((term) => haystack.includes(term)) && (!dimension.value || row.dataset.dimension === dimension.value) && (!stance.value || row.dataset.stance === stance.value);
        row.hidden = !show;
        if (show) visible += 1;
        body.append(row);
      }
      count.textContent = visible.toLocaleString('en-GB');
      wrap.hidden = visible === 0;
      empty.hidden = visible !== 0;
      clear.disabled = !search.value && !dimension.value && !stance.value && sort.value === 'dimension';
      syncUrl();
    };
    const clearAll = () => { search.value = ''; dimension.value = ''; stance.value = ''; sort.value = 'dimension'; update(); search.focus(); };
    [search, dimension, stance, sort].forEach((control) => control.addEventListener(control === search ? 'input' : 'change', update));
    clear.addEventListener('click', clearAll);
    emptyClear.addEventListener('click', clearAll);
    update();
  });
</script>

<style>
  .assignment-section { scroll-margin-top: calc(var(--header-height) + 5rem); border-top: 1px solid var(--line); padding-top: clamp(2.8rem, 6vw, 4.8rem); margin-top: clamp(2.8rem, 6vw, 4.8rem); }
  .section-heading { display: flex; justify-content: space-between; gap: 1.5rem; align-items: start; margin-bottom: 1.2rem; }
  .section-heading > div:first-child { max-width: 790px; }
  .section-heading h2 { margin-bottom: 0.45rem; font-size: clamp(1.7rem, 3vw, 2.25rem); }
  .section-heading p:not(.table-kicker) { margin: 0; color: var(--muted); }
  .table-kicker { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.6rem !important; color: var(--teal) !important; font-size: 0.69rem; font-weight: 760; letter-spacing: 0.09em; text-transform: uppercase; }
  .table-kicker span { width: 1.5rem; height: 1px; background: currentColor; }
  .assignment-controls { display: grid; grid-template-columns: minmax(230px, 1fr) 210px 155px 165px auto; gap: 0.75rem; align-items: end; border: 1px solid var(--line); border-radius: 0.9rem; background: linear-gradient(145deg, color-mix(in srgb, var(--surface) 94%, var(--teal) 6%), var(--surface)); padding: 1rem; box-shadow: 0 10px 28px color-mix(in srgb, var(--ink) 5%, transparent); }
  .controls-heading { display: flex; grid-column: 1 / -1; gap: 0.65rem; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 0.8rem; }
  .controls-heading svg { color: var(--teal); }
  .controls-heading strong, .controls-heading span { display: block; }
  .controls-heading strong { font-size: 0.82rem; }
  .controls-heading span { color: var(--muted); font-size: 0.72rem; }
  .assignment-controls .select { width: 100%; }
  .search-control > span:last-child { position: relative; display: block; }
  .search-control svg { position: absolute; z-index: 1; top: 12px; left: 12px; color: var(--faint); }
  .search-control input { width: 100%; padding-left: 2.4rem; }
  .clear-button { min-width: 86px; }
  .clear-button:disabled { cursor: not-allowed; opacity: 0.46; }
  .assignment-summary { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin: 0.9rem 0; color: var(--muted); font-size: 0.78rem; }
  .assignment-summary p { margin: 0; }
  .assignment-summary strong { color: var(--ink); font-variant-numeric: tabular-nums; }
  .assignment-summary > span { color: var(--faint); font-size: 0.7rem; }
  .assignment-wrap { max-height: min(72vh, 780px); border-radius: 0.9rem; }
  table { min-width: 1050px; }
  th:first-child { width: 24%; }
  th:nth-child(4) { width: 42%; }
  tbody tr:nth-child(even) { background: color-mix(in srgb, var(--surface-2) 48%, transparent); }
  td a { color: var(--ink); font-weight: 650; text-decoration-color: color-mix(in srgb, var(--blue) 35%, transparent); }
  td a:hover { color: var(--blue); }
  code { color: var(--faint); font-size: 0.72rem; }
  .empty-state { border-radius: 0.9rem; }
  .empty-state p { margin: 0.35rem 0 1rem; color: var(--muted); }
  @media (max-width: 1040px) { .assignment-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); } .search-control { grid-column: 1 / -1; } .clear-button { width: 100%; } }
  @media (max-width: 700px) {
    .assignment-section { scroll-margin-top: calc(var(--header-height) + 8rem); }
    .section-heading { flex-direction: column; }
    .section-heading .cluster { width: 100%; }
    .section-heading .button { flex: 1 1 auto; }
    .assignment-controls { grid-template-columns: 1fr; }
    .search-control { grid-column: auto; }
    .assignment-summary { align-items: start; flex-direction: column; gap: 0.2rem; }
    .assignment-wrap { overflow: visible; border: 0; background: transparent; }
    table, tbody, tr, td { display: block; min-width: 0; width: 100%; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
    tbody { display: grid; gap: 0.75rem; }
    tbody tr { overflow: hidden; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--surface); box-shadow: 0 7px 20px color-mix(in srgb, var(--ink) 5%, transparent); }
    tbody tr[hidden] { display: none; }
    td { display: grid; grid-template-columns: 7.2rem minmax(0, 1fr); gap: 0.65rem; border-bottom: 1px solid var(--line); padding: 0.7rem 0.8rem; }
    td:last-child { border-bottom: 0; }
    td::before { content: attr(data-label); color: var(--faint); font-size: 0.66rem; font-weight: 760; letter-spacing: 0.05em; text-transform: uppercase; }
  }
</style>
