---
interface Section { level: number; heading: string; slug: string; html: string; }
interface Props { sections: Section[]; base: string; }
const { sections, base } = Astro.props;
---

<div class="prose document-prose">
  {sections.map((section, index) => {
    const headingId = `${section.slug}-heading`;
    return (
      <section class="document-section" id={section.slug} aria-labelledby={headingId} data-document-section data-pagefind-body>
        <header class="section-heading">
          <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {section.level === 2 ? <h2 id={headingId}>{section.heading}</h2> : section.level === 3 ? <h3 id={headingId}>{section.heading}</h3> : <h4 id={headingId}>{section.heading}</h4>}
        </header>
        <div class="section-copy" set:html={section.html.replaceAll('__BASE__', base)} />
      </section>
    );
  })}
</div>

<style>
  .document-prose { max-width: 100%; }
  .document-section {
    position: relative;
    scroll-margin-top: calc(var(--header-height) + 5rem);
    border-top: 1px solid var(--line);
    padding-top: clamp(2.3rem, 5vw, 4.2rem);
    margin-top: clamp(2.3rem, 5vw, 4.2rem);
  }
  .document-section:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .section-heading { display: grid; grid-template-columns: 2.3rem minmax(0, 1fr); gap: 0.8rem; align-items: start; margin-bottom: 1.35rem; }
  .section-heading h2, .section-heading h3, .section-heading h4 { margin: 0; text-wrap: balance; }
  .section-heading h2 { font-size: clamp(1.75rem, 3vw, 2.3rem); }
  .section-heading h3 { padding-top: 0.15rem; font-family: var(--font-serif); font-size: clamp(1.35rem, 2.4vw, 1.7rem); }
  .section-number { display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border: 1px solid color-mix(in srgb, var(--teal) 38%, var(--line)); border-radius: 50%; color: var(--teal); font-family: var(--font-sans); font-size: 0.66rem; font-weight: 760; letter-spacing: 0.04em; }
  .section-copy { min-width: 0; }
  .section-copy :global(p) { color: color-mix(in srgb, var(--ink) 86%, var(--muted)); text-wrap: pretty; }
  .section-copy :global(p:first-child) { font-size: 1.12em; line-height: 1.72; }
  .section-copy :global(a) { text-decoration-color: color-mix(in srgb, var(--blue) 45%, transparent); }
  .section-copy :global(blockquote) { border-left: 3px solid var(--teal); margin: 1.6rem 0; background: color-mix(in srgb, var(--teal) 6%, transparent); padding: 1rem 1.2rem; }
  .section-copy :global(ul), .section-copy :global(ol) { padding-left: 1.35rem; }
  .section-copy :global(li) { margin-bottom: 0.5rem; padding-left: 0.2rem; }
  .section-copy :global(.table-wrap) { margin-block: 1.5rem; font-family: var(--font-sans); }
  @media (max-width: 700px) {
    .document-section { scroll-margin-top: calc(var(--header-height) + 8rem); }
    .section-heading { grid-template-columns: 1.85rem minmax(0, 1fr); gap: 0.65rem; }
    .section-number { width: 1.75rem; height: 1.75rem; }
    .section-copy :global(p:first-child) { font-size: 1.05em; }
  }
</style>
